    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch file",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "bin/cellpipe",
            "args": [
                "indexraster",
                "-v",
                "-w",
                "6",
                "-m",
                "12",
                "--aggFunc",
                "mean",
                "-l",
                "11",
                "/Users/terence.johnson/misc/DEM/aster-4326.tif",
                "./test"
            ]
        },
        {
            "name": "Python Debugger: Current File LU Layer",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--inputPath",
                "~/projects/qgis/flintbase-scratch/biodiv-layers/totalCurrentPotential.tif",
                "--outPath",
                "luPressure.csv",
                "--chunkSize",
                "100"
            ]
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--inputPath",
                "~/projects/qgis/flintbase-scratch/biodiv-layers/smallBI.tif",
                "--outPath",
                "test.csv",
                "--chunkSize",
                "1"
            ]
        }
    ]
